# Frontend Environment Variables (Optional - only needed for non-standard setups)

# Backend API URL (Vite proxy handles this automatically in dev mode)
# VITE_API_URL=http://localhost:8000

# Default user ID for new sessions
# VITE_DEFAULT_USER_ID=demo_user

# Note: In development, the Vite dev server proxies /api calls to the backend.
# In production, ensure your backend is accessible at the correct URL.