# --- App ---
ENVIRONMENT=development
DATABASE_URL=sqlite:///./b2ai.db
JWT_SECRET=change-me-in-production

# --- AI / Agent ---
# Set AGENT_PROVIDER=mock to skip OpenAI entirely (rule-based intent parsing)
AGENT_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Avalanche Fuji (XSGD settlement) ---
# Set SIMULATE_SETTLEMENT=true to never hit the chain (demo-safe)
SIMULATE_SETTLEMENT=false
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
XSGD_CONTRACT_ADDRESS=0x...
SETTLEMENT_PRIVATE_KEY=0x...
CHAIN_ID=43113
SETTLEMENT_NETWORK=Avalanche Fuji C-Chain

# --- Policy defaults ---
DEFAULT_MAX_TRANSACTION=100
DEFAULT_DAILY_LIMIT=500
DEFAULT_CURRENCY=XSGD
DEFAULT_ALLOWED_MERCHANTS=Nike,Amazon,Apple